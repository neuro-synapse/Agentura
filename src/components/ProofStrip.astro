---
import type { HomeProofItem } from "../data/site";

interface Props {
  items: HomeProofItem[];
}

const { items } = Astro.props;
---

<section class="proof-strip" data-reveal>
  <div class="container">
    <div class="proof-grid" data-stagger="0.08">
      {items.map((item) => (
        <article class="proof-card surface-card" data-reveal>
          <span class="proof-label">{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.body}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }
  .proof-strip {
    padding: 0 0 3rem;
  }
  .proof-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .proof-card {
    padding: 1.4rem 1.4rem 1.5rem;
  }
  .proof-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.85rem;
  }
  .proof-card h3 {
    font-family: var(--font-serif);
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 0.7rem;
  }
  .proof-card p {
    font-size: 0.92rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }

  @media (max-width: 900px) {
    .proof-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1.5rem;
    }
    .proof-strip {
      padding-bottom: 2rem;
    }
  }
</style>
