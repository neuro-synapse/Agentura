---
import type { SiteAction, SiteDetail } from "../data/site";

interface Props {
  id?: string;
  kicker?: string;
  heading?: string;
  body?: string;
  primary?: SiteAction;
  secondary?: SiteAction;
  details?: SiteDetail[];
}

const {
  id = "contact",
  kicker = "Let’s find the right workflow",
  heading = "Start with a concrete workflow, not a pitch deck.",
  body = "We begin with the work itself: where judgment lives, where coordination drags, and where a dependable agentic layer would actually change the day-to-day.",
  primary = {
    label: "Start a conversation",
    href: "mailto:hello@agentura.dev",
    note: "Tell us the workflow you are trying to change",
  },
  secondary,
  details = [],
} = Astro.props;
---

<section id={id} class="section-cta">
  <div class="container">
    <div class="cta-shell">
      <div class="cta-main">
        <div class="cta-ornament"></div>
        <p class="cta-kicker">{kicker}</p>
        <div class="cta-copy">
          <h2>{heading}</h2>
          <p>{body}</p>
        </div>
        <div class="cta-actions">
          <a href={primary.href} class="btn btn-primary btn-large">{primary.label}</a>
          {secondary && (
            <a href={secondary.href} class="btn btn-secondary btn-large">{secondary.label}</a>
          )}
        </div>
        <div class="cta-notes">
          <span>{primary.note}</span>
          {secondary?.note && <span>{secondary.note}</span>}
        </div>
      </div>

      {details.length > 0 && (
        <div class="cta-details">
          {details.map((detail) => (
            <div class="cta-detail">
              <span class="cta-detail-label">{detail.label}</span>
              <p>{detail.value}</p>
            </div>
          ))}
        </div>
      )}
    </div>
  </div>
</section>

<style>
  .section-cta {
    background: linear-gradient(135deg, var(--color-text) 0%, #26211d 100%);
    color: white;
    padding: var(--space-xl) 0;
    position: relative;
    overflow: hidden;
  }
  .section-cta::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 80% 20%, rgba(255,255,255,0.08) 0%, transparent 60%),
      radial-gradient(ellipse at 20% 80%, rgba(196,149,106,0.08) 0%, transparent 65%);
    pointer-events: none;
  }
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }
  .cta-shell {
    display: grid;
    grid-template-columns: minmax(0, 1.7fr) minmax(260px, 0.9fr);
    gap: 2rem;
    align-items: start;
    position: relative;
    z-index: 1;
  }
  .cta-main {
    max-width: 680px;
  }
  .cta-ornament {
    width: 40px;
    height: 1px;
    background: rgba(255,255,255,0.4);
    margin-bottom: 1.5rem;
    position: relative;
  }
  .cta-ornament::before {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    border: 1px solid rgba(255,255,255,0.4);
    border-radius: 50%;
    top: -3px;
    left: -10px;
  }
  .cta-kicker {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.68);
    margin-bottom: 1rem;
  }
  .cta-copy h2 {
    font-family: var(--font-serif);
    font-size: clamp(2rem, 4vw, 2.8rem);
    font-weight: 400;
    margin-bottom: 1.25rem;
    line-height: 1.15;
  }
  .cta-copy p {
    font-size: 1.05rem;
    line-height: 1.7;
    color: rgba(255, 255, 255, 0.8);
    margin-bottom: 2rem;
  }
  .cta-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-bottom: 1rem;
  }
  .cta-notes {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.58);
  }
  .cta-details {
    display: grid;
    gap: 1rem;
  }
  .cta-detail {
    background: rgba(255,255,255,0.06);
    border: 1px solid rgba(255,255,255,0.12);
    border-radius: 12px;
    padding: 1rem 1rem 1.1rem;
    backdrop-filter: blur(8px);
  }
  .cta-detail-label {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: rgba(255,255,255,0.58);
    margin-bottom: 0.65rem;
  }
  .cta-detail p {
    font-size: 0.96rem;
    line-height: 1.55;
    color: rgba(255,255,255,0.88);
  }

  @media (max-width: 900px) {
    .cta-shell {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .container {
      padding: 0 1.5rem;
    }
    .cta-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .cta-actions .btn {
      width: 100%;
      text-align: center;
    }
  }
</style>
