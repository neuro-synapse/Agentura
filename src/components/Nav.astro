---
import { siteLinks } from "../data/site";

const pathname = Astro.url.pathname;

const links = [
  { href: "/tao", label: "Principles" },
  { href: "/services", label: "Services" },
  { href: "/blog", label: "Blog" },
  { href: "/#process", label: "Process" },
  { href: "/#contact", label: "Contact" },
];
---

<nav class="nav">
  <div class="nav-inner">
    <a href="/" class="wordmark">Agentura</a>
    <a href={siteLinks.startHere} class="nav-cta-mobile">Start here</a>
    <div class="nav-links" id="nav-links">
      {links.map(({ href, label }) => (
        <a
          href={href}
          class:list={[{ active: pathname === href || (href !== "/" && pathname.startsWith(href)) }]}
        >
          {label}
        </a>
      ))}
      <a href={siteLinks.conversation} class="nav-cta">Talk to us</a>
    </div>
    <button
      class="menu-toggle"
      aria-label="Toggle menu"
      aria-controls="nav-links"
      aria-expanded="false"
      id="menu-toggle"
    >
      <span></span><span></span>
    </button>
  </div>
</nav>

<script>
  const toggle = document.getElementById("menu-toggle");
  const links = document.getElementById("nav-links");

  if (toggle && links) {
    toggle.addEventListener("click", () => {
      const isOpen = links.classList.toggle("open");
      toggle.classList.toggle("open", isOpen);
      toggle.setAttribute("aria-expanded", String(isOpen));
    });

    links.querySelectorAll("a").forEach((a) => {
      a.addEventListener("click", () => {
        links.classList.remove("open");
        toggle.classList.remove("open");
        toggle.setAttribute("aria-expanded", "false");
      });
    });
  }
</script>

<noscript>
  <style>
    @media (max-width: 768px) {
      .nav-inner {
        flex-wrap: wrap;
      }

      .nav-links {
        display: flex !important;
        position: static !important;
        width: 100%;
        padding: 1rem 0 0;
        margin-top: 0.9rem;
        border-top: 1px solid #d4cdc4;
        flex-direction: column;
        align-items: flex-start !important;
      }

      .menu-toggle {
        display: none !important;
      }
    }
  </style>
</noscript>

<style>
  .nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 100;
    background: rgba(250, 248, 245, 0.92);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 1.05rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 1rem;
    position: relative;
  }
  .wordmark {
    font-family: var(--font-serif);
    font-size: 1.5rem;
    font-weight: 500;
    color: var(--color-text);
    border-bottom: none;
    letter-spacing: -0.01em;
  }
  .wordmark:hover {
    border-bottom: none;
  }
  .nav-cta-mobile {
    display: none;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-bg) !important;
    background: var(--color-text);
    border-radius: 999px;
    padding: 0.65rem 0.95rem;
    border-bottom: none;
  }
  .nav-cta-mobile:hover {
    background: var(--color-accent);
    border-bottom: none;
  }
  .nav-links {
    display: flex;
    gap: 2.25rem;
    align-items: center;
  }
  .nav-links a {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: none;
    transition: color 0.2s;
    position: relative;
  }
  .nav-links a::after {
    content: "";
    position: absolute;
    bottom: -4px;
    left: 0;
    width: 100%;
    height: 1.5px;
    background: var(--color-accent);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.3s ease;
  }
  .nav-links a:hover::after,
  .nav-links a.active::after {
    transform: scaleX(1);
    transform-origin: left;
  }
  .nav-links a:hover,
  .nav-links a.active {
    color: var(--color-text);
    border-bottom: none;
  }
  .nav-links a.active {
    color: var(--color-accent);
  }
  .nav-cta {
    background: var(--color-text);
    color: var(--color-bg) !important;
    padding: 0.58rem 1.2rem;
    border-radius: 999px;
    transition: background 0.2s;
  }
  .nav-cta::after {
    display: none;
  }
  .nav-cta:hover {
    background: var(--color-accent) !important;
  }
  .menu-toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 4px;
  }
  .menu-toggle span {
    width: 20px;
    height: 1.5px;
    background: var(--color-text);
    transition: transform 0.3s, opacity 0.3s;
    display: block;
  }
  .menu-toggle.open span:first-child {
    transform: rotate(45deg) translate(2.3px, 2.3px);
  }
  .menu-toggle.open span:last-child {
    transform: rotate(-45deg) translate(2.3px, -2.3px);
  }

  @media (max-width: 768px) {
    .nav-inner {
      padding: 0.95rem 1.5rem;
    }
    .nav-cta-mobile {
      display: inline-flex;
      margin-left: auto;
    }
    .nav-links {
      position: absolute;
      top: calc(100% + 1px);
      left: 0;
      right: 0;
      background: rgba(250, 248, 245, 0.98);
      backdrop-filter: blur(12px);
      flex-direction: column;
      align-items: stretch;
      padding: 1.25rem 1.5rem 1.5rem;
      gap: 1rem;
      border-bottom: 1px solid var(--color-border);
      box-shadow: 0 12px 24px rgba(0, 0, 0, 0.06);
    }
    .nav-links {
      display: none;
    }
    .nav-links.open {
      display: flex;
    }
    .menu-toggle {
      display: flex;
    }
    .nav-links .nav-cta {
      text-align: center;
    }
  }
</style>
