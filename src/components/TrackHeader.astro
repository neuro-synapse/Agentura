---
interface Props {
  label: string;
  title: string;
  description: string;
}
const { label, title, description } = Astro.props;
---

<div class="track-header" data-reveal>
  <div class="track-label">{label}</div>
  <h2 class="track-title">{title}</h2>
  <p class="track-desc">{description}</p>
</div>

<style>
  .track-header {
    padding: 5rem 0 2rem;
    text-align: center;
  }
  .track-label {
    font-family: var(--font-mono);
    font-size: 0.55rem;
    font-weight: 500;
    letter-spacing: 0.4em;
    text-transform: uppercase;
    color: var(--color-accent);
    display: inline-block;
    border: 1px solid var(--color-accent-light);
    padding: 0.3rem 1rem;
    border-radius: 2px;
    margin-bottom: 1.2rem;
  }
  .track-title {
    font-family: var(--font-serif);
    font-weight: 400;
    font-size: clamp(1.6rem, 3vw, 2.2rem);
    color: var(--color-text);
    line-height: 1.2;
    margin-bottom: 0.6rem;
  }
  .track-desc {
    font-family: var(--font-serif);
    font-weight: 300;
    font-style: italic;
    font-size: 1rem;
    color: var(--color-text-muted);
    max-width: 480px;
    margin: 0 auto;
  }
</style>
