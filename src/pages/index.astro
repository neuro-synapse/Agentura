---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Agentura">
  <nav class="nav">
    <div class="nav-inner">
      <a href="/" class="logo">Agentura</a>
      <div class="nav-links">
        <a href="#features">Features</a>
        <a href="#how">How it works</a>
        <a href="#cta" class="btn-nav">Get started</a>
      </div>
    </div>
  </nav>

  <main>
    <section class="hero">
      <div class="hero-glow"></div>
      <div class="container">
        <span class="badge">Now in beta</span>
        <h1>Autonomous agents<br /><span class="gradient-text">that actually work</span></h1>
        <p class="subtitle">
          Agentura lets you design, deploy, and observe AI agents that operate
          independently — with guardrails you control.
        </p>
        <div class="hero-actions">
          <a href="#cta" class="btn btn-primary">Start building</a>
          <a href="#how" class="btn btn-secondary">See how it works</a>
        </div>
      </div>
    </section>

    <section id="features" class="features">
      <div class="container">
        <h2>Built for serious agent work</h2>
        <div class="grid">
          <div class="card">
            <div class="card-icon">&#x1F9E0;</div>
            <h3>Reasoning loops</h3>
            <p>Agents plan, act, and reflect in structured loops — no spaghetti chains.</p>
          </div>
          <div class="card">
            <div class="card-icon">&#x1F6E1;</div>
            <h3>Guardrails</h3>
            <p>Define boundaries, budgets, and approval gates before agents go live.</p>
          </div>
          <div class="card">
            <div class="card-icon">&#x1F50D;</div>
            <h3>Observability</h3>
            <p>Full trace of every decision, tool call, and state change in real time.</p>
          </div>
          <div class="card">
            <div class="card-icon">&#x26A1;</div>
            <h3>Edge-native</h3>
            <p>Runs on Cloudflare Workers — low latency, global scale, zero servers to manage.</p>
          </div>
          <div class="card">
            <div class="card-icon">&#x1F527;</div>
            <h3>Tool ecosystem</h3>
            <p>Connect any API as a tool. MCP-compatible out of the box.</p>
          </div>
          <div class="card">
            <div class="card-icon">&#x1F465;</div>
            <h3>Multi-agent</h3>
            <p>Compose agents into teams with delegation, handoffs, and shared state.</p>
          </div>
        </div>
      </div>
    </section>

    <section id="how" class="how">
      <div class="container">
        <h2>How it works</h2>
        <div class="steps">
          <div class="step">
            <div class="step-num">1</div>
            <div>
              <h3>Define your agent</h3>
              <p>Describe its goal, tools, and constraints in a simple config.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-num">2</div>
            <div>
              <h3>Deploy to the edge</h3>
              <p>One command to push your agent to Cloudflare's global network.</p>
            </div>
          </div>
          <div class="step">
            <div class="step-num">3</div>
            <div>
              <h3>Observe & iterate</h3>
              <p>Watch your agent work in real time. Adjust guardrails as you learn.</p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="cta" class="cta">
      <div class="container">
        <h2>Ready to build?</h2>
        <p>Get started with Agentura in under 5 minutes.</p>
        <code class="install-cmd">npx create-agentura@latest my-agent</code>
        <a href="https://github.com" class="btn btn-primary" style="margin-top: 1.5rem;">View on GitHub</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <p>&copy; 2026 Agentura. Built on Cloudflare.</p>
    </div>
  </footer>
</Layout>

<style>
  /* Nav */
  .nav {
    position: fixed;
    top: 0;
    width: 100%;
    z-index: 100;
    backdrop-filter: blur(12px);
    background: rgba(10, 10, 15, 0.8);
    border-bottom: 1px solid var(--color-border);
  }
  .nav-inner {
    max-width: 1100px;
    margin: 0 auto;
    padding: 1rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .logo {
    font-size: 1.25rem;
    font-weight: 700;
    color: var(--color-text);
    letter-spacing: -0.02em;
  }
  .logo:hover { text-decoration: none; }
  .nav-links {
    display: flex;
    gap: 2rem;
    align-items: center;
  }
  .nav-links a { color: var(--color-text-muted); font-size: 0.9rem; }
  .nav-links a:hover { color: var(--color-text); text-decoration: none; }
  .btn-nav {
    background: var(--color-accent);
    color: white !important;
    padding: 0.5rem 1.25rem;
    border-radius: 8px;
    font-weight: 500;
  }
  .btn-nav:hover { opacity: 0.9; }

  /* Layout */
  .container {
    max-width: 1100px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* Hero */
  .hero {
    position: relative;
    padding: 10rem 0 6rem;
    text-align: center;
    overflow: hidden;
  }
  .hero-glow {
    position: absolute;
    top: -200px;
    left: 50%;
    transform: translateX(-50%);
    width: 800px;
    height: 600px;
    background: radial-gradient(ellipse, var(--color-glow) 0%, transparent 70%);
    pointer-events: none;
  }
  .badge {
    display: inline-block;
    padding: 0.35rem 1rem;
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--color-accent-light);
    border: 1px solid var(--color-accent);
    border-radius: 999px;
    margin-bottom: 2rem;
    letter-spacing: 0.03em;
  }
  h1 {
    font-size: clamp(2.5rem, 6vw, 4.5rem);
    font-weight: 800;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.5rem;
  }
  .gradient-text {
    background: linear-gradient(135deg, var(--color-accent-light), #74b9ff);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
  }
  .subtitle {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: 560px;
    margin: 0 auto 2.5rem;
    line-height: 1.6;
  }
  .hero-actions {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  /* Buttons */
  .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    border-radius: 10px;
    font-weight: 600;
    font-size: 1rem;
    transition: all 0.2s;
  }
  .btn:hover { text-decoration: none; }
  .btn-primary {
    background: var(--color-accent);
    color: white;
  }
  .btn-primary:hover {
    box-shadow: 0 0 24px var(--color-glow);
    transform: translateY(-1px);
  }
  .btn-secondary {
    background: var(--color-surface);
    color: var(--color-text);
    border: 1px solid var(--color-border);
  }
  .btn-secondary:hover {
    border-color: var(--color-accent);
  }

  /* Features */
  .features {
    padding: 6rem 0;
  }
  .features h2, .how h2, .cta h2 {
    text-align: center;
    font-size: 2rem;
    font-weight: 700;
    margin-bottom: 3rem;
    letter-spacing: -0.02em;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.5rem;
  }
  .card {
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    border-radius: 14px;
    padding: 2rem;
    transition: border-color 0.2s;
  }
  .card:hover {
    border-color: var(--color-accent);
  }
  .card-icon {
    font-size: 1.8rem;
    margin-bottom: 1rem;
  }
  .card h3 {
    font-size: 1.1rem;
    font-weight: 600;
    margin-bottom: 0.5rem;
  }
  .card p {
    color: var(--color-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
  }

  /* How */
  .how {
    padding: 6rem 0;
  }
  .steps {
    max-width: 600px;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 2rem;
  }
  .step {
    display: flex;
    gap: 1.5rem;
    align-items: flex-start;
  }
  .step-num {
    flex-shrink: 0;
    width: 44px;
    height: 44px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--color-accent);
    border-radius: 12px;
    font-weight: 700;
    font-size: 1.1rem;
  }
  .step h3 {
    font-size: 1.1rem;
    margin-bottom: 0.3rem;
  }
  .step p {
    color: var(--color-text-muted);
    line-height: 1.5;
  }

  /* CTA */
  .cta {
    padding: 6rem 0;
    text-align: center;
  }
  .cta p {
    color: var(--color-text-muted);
    margin-bottom: 2rem;
    font-size: 1.1rem;
  }
  .install-cmd {
    display: inline-block;
    background: var(--color-surface);
    border: 1px solid var(--color-border);
    padding: 0.75rem 1.5rem;
    border-radius: 10px;
    font-family: "SF Mono", "Fira Code", monospace;
    font-size: 0.95rem;
    color: var(--color-accent-light);
    user-select: all;
  }

  /* Footer */
  .footer {
    border-top: 1px solid var(--color-border);
    padding: 2rem 0;
    text-align: center;
  }
  .footer p {
    color: var(--color-text-muted);
    font-size: 0.85rem;
  }

  /* Mobile */
  @media (max-width: 640px) {
    .nav-links a:not(.btn-nav) { display: none; }
    .hero { padding: 8rem 0 4rem; }
  }
</style>
