---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import SectionHeader from "../components/SectionHeader.astro";
import PrincipleCard from "../components/PrincipleCard.astro";
import CTA from "../components/CTA.astro";
import ProofStrip from "../components/ProofStrip.astro";
import { homepagePrinciples } from "../data/principles";
import { getServicesByTrack, tracks } from "../data/services";
import { homeProofItems, routeCtas, siteLinks } from "../data/site";

const homeCta = routeCtas.home;
const trackCounts = {
  I: getServicesByTrack("I").length,
  II: getServicesByTrack("II").length,
  III: getServicesByTrack("III").length,
};
---

<Layout title="Agentura — Dependable AI for real work">
  <Nav />

  <main>
    <section class="hero">
      <div class="hero-copy" data-reveal>
        <div class="hero-label">
          <span class="label-dot"></span>
          <span class="label-text">Agentic systems that compound in value</span>
        </div>
        <h1>
          We design, build, and operationalize agentic systems that do <em>real work</em>.
        </h1>
        <p class="hero-lead">
          Most AI work stalls between prototype and operations. The demos look promising, but the
          edge cases, tool boundaries, and trust questions are still sitting unresolved in the
          workflow.
        </p>
        <p class="hero-supporting">
          We close that gap by designing the harness around the model: intent, specifications,
          tools, governance, and the narrow first deployment that lets a team trust what ships.
        </p>
        <ul class="hero-points">
          <li>Start with a one-week readiness assessment instead of a platform commitment.</li>
          <li>Document the knowledge and constraints your agents will actually need.</li>
          <li>Deploy narrow first, then widen once the system survives real work.</li>
        </ul>
        <div class="hero-actions">
          <a href={siteLinks.startHere} class="btn btn-primary btn-large">Start with the assessment</a>
          <a href="#process" class="btn btn-ghost btn-large">See how we work</a>
        </div>
      </div>

      <aside class="hero-support surface-card" data-reveal>
        <p class="hero-support-label">Where we fit best</p>
        <h2>Dependable software with modern AI under the hood.</h2>
        <p class="hero-support-copy">
          We are most useful when the workflow already matters, the stakes are real, and the
          knowledge lives inside people rather than a tidy API schema.
        </p>
        <div class="hero-support-grid">
          <div class="support-row">
            <span>Not for</span>
            <p>Teams looking for generic AI theater, trend language, or feature-branding.</p>
          </div>
          <div class="support-row">
            <span>Best for</span>
            <p>Operators who need specifications, tool contracts, governance, and deployment paths around real work.</p>
          </div>
          <div class="support-row">
            <span>Result</span>
            <p>A narrower first deployment and artifacts your team still owns after we leave.</p>
          </div>
        </div>
      </aside>
    </section>

    <ProofStrip items={homeProofItems} />

    <section id="tracks" class="section section-dark" data-reveal>
      <div class="container">
        <SectionHeader num="I" dark>Choose a<br />starting path</SectionHeader>
        <p class="section-intro">
          Three entry paths, each shaped around a different kind of bottleneck. If you are still
          figuring out where to begin, start with the readiness assessment first.
        </p>

        <div class="tracks-grid" data-stagger="0.12">
          <a href="/services#t1" class="track-card" data-reveal>
            <span class="track-label">{tracks.I.label}</span>
            <span class="track-meta">{trackCounts.I} linked services</span>
            <h3>{tracks.I.title}</h3>
            <p>{tracks.I.description}</p>
            <span class="track-services">
              Intent Mapping · Tool Architecture · Platform Design · Ambient Agents · Observability
            </span>
            <span class="track-link">Explore Track I &rarr;</span>
          </a>
          <a href="/services#t2" class="track-card" data-reveal>
            <span class="track-label">{tracks.II.label}</span>
            <span class="track-meta">{trackCounts.II} focused offer</span>
            <h3>{tracks.II.title}</h3>
            <p>{tracks.II.description}</p>
            <span class="track-services">Agent Experience Design · Retrieval-ready docs · Tool surfaces</span>
            <span class="track-link">Explore Track II &rarr;</span>
          </a>
          <a href="/services#t3" class="track-card" data-reveal>
            <span class="track-label">{tracks.III.label}</span>
            <span class="track-meta">{trackCounts.III} packaged offers</span>
            <h3>{tracks.III.title}</h3>
            <p>{tracks.III.description}</p>
            <span class="track-services">Operations Copilot · Workflow Packages · Knowledge Capture</span>
            <span class="track-link">Explore Track III &rarr;</span>
          </a>
        </div>
      </div>
    </section>

    <section id="process" class="section" data-reveal>
      <div class="container">
        <SectionHeader num="II">How we<br />work</SectionHeader>
        <p class="section-intro-light">
          Start from intent. Specify before you automate. Make the reasoning and the constraints
          visible before asking the workflow to trust the system.
        </p>

        <div class="process-timeline">
          <div class="process-step" data-reveal>
            <div class="step-marker">
              <span class="step-number">1</span>
              <span class="step-line"></span>
            </div>
            <div class="step-content">
              <h3>Clarify intent, not features</h3>
              <p>
                We sit with the people who actually do the work. We watch how it happens in the
                real tools and identify what outcome needs to change in reality.
              </p>
            </div>
          </div>
          <div class="process-step" data-reveal>
            <div class="step-marker">
              <span class="step-number">2</span>
              <span class="step-line"></span>
            </div>
            <div class="step-content">
              <h3>Extract knowledge, specify decisions</h3>
              <p>
                We turn tacit judgment into scenarios, heuristics, and explicit constraints so the
                workflow no longer depends on one person remembering the edge cases.
              </p>
            </div>
          </div>
          <div class="process-step" data-reveal>
            <div class="step-marker">
              <span class="step-number">3</span>
              <span class="step-line"></span>
            </div>
            <div class="step-content">
              <h3>Design the harness, not just the model</h3>
              <p>
                Tools are shaped around intention, not raw APIs. Guardrails, context flow, and
                evaluation loops are designed before the automation is asked to carry load.
              </p>
            </div>
          </div>
          <div class="process-step" data-reveal>
            <div class="step-marker">
              <span class="step-number">4</span>
              <span class="step-line"></span>
            </div>
            <div class="step-content">
              <h3>Build fast, deploy narrow</h3>
              <p>
                We favor constrained pilots in the real workflow rather than broad AI launches. The
                system earns trust in a narrow lane before it widens.
              </p>
            </div>
          </div>
          <div class="process-step" data-reveal>
            <div class="step-marker">
              <span class="step-number">5</span>
              <span class="step-line"></span>
            </div>
            <div class="step-content">
              <h3>Observe, evaluate, compound</h3>
              <p>
                Every mistake feeds back into the harness. We want a system that gets more useful
                because it touched reality, not despite it.
              </p>
            </div>
          </div>
          <div class="process-step" data-reveal>
            <div class="step-marker">
              <span class="step-number">6</span>
            </div>
            <div class="step-content">
              <h3>Hand off and expand</h3>
              <p>
                The team keeps the artifacts, the operating logic, and the documented knowledge. If
                the first deployment proves out, the next one starts from stronger ground.
              </p>
            </div>
          </div>
        </div>
      </div>
    </section>

    <section id="principles" class="section section-warm" data-reveal>
      <div class="container">
        <SectionHeader num="III">What we<br />believe</SectionHeader>
        <p class="principles-intro">
          The work is downstream of a set of operating convictions: less demo theater, more
          explicit intent, tighter tool design, and systems that compound from contact with reality.
        </p>

        <div class="principles-grid" data-stagger="0.08">
          {homepagePrinciples.map((p) => (
            <div data-reveal>
              <PrincipleCard number={p.number} title={p.title} body={p.body} />
            </div>
          ))}
        </div>

        <div class="principles-more" data-reveal>
          <a href="/tao" class="btn btn-soft">Read all fifteen principles &rarr;</a>
        </div>
      </div>
    </section>

    <CTA
      kicker={homeCta.kicker}
      heading={homeCta.heading}
      body={homeCta.body}
      primary={homeCta.primary}
      secondary={homeCta.secondary}
      details={homeCta.details}
    />
  </main>

  <Footer />
</Layout>

<style>
  .container {
    max-width: var(--max-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .hero {
    padding: 8.5rem 2rem 3rem;
    max-width: var(--max-width);
    margin: 0 auto;
    display: grid;
    grid-template-columns: minmax(0, 1.35fr) minmax(300px, 0.9fr);
    gap: 2rem;
    align-items: start;
    position: relative;
  }
  .hero::before {
    content: "";
    position: absolute;
    top: -3rem;
    left: -8%;
    right: -8%;
    bottom: 0;
    background:
      radial-gradient(ellipse at 20% 30%, rgba(139, 69, 19, 0.04) 0%, transparent 55%),
      radial-gradient(ellipse at 78% 62%, rgba(139, 69, 19, 0.03) 0%, transparent 58%);
    pointer-events: none;
    z-index: -1;
  }
  .hero-copy {
    max-width: 720px;
  }
  .hero-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.6rem;
  }
  .label-dot {
    width: 8px;
    height: 8px;
    background: var(--color-accent);
    border-radius: 50%;
  }
  .label-text {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-secondary);
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 6vw, 4.8rem);
    font-weight: 300;
    line-height: 1.02;
    letter-spacing: -0.03em;
    margin-bottom: 1.35rem;
    max-width: 10ch;
  }
  .hero h1 em {
    font-style: italic;
    font-weight: 500;
    color: var(--color-accent);
  }
  .hero-lead {
    font-size: 1.12rem;
    line-height: 1.7;
    color: var(--color-text);
    max-width: 58ch;
    margin-bottom: 0.95rem;
  }
  .hero-supporting {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 56ch;
    margin-bottom: 1.35rem;
  }
  .hero-points {
    list-style: none;
    display: grid;
    gap: 0.8rem;
    margin-bottom: 1.6rem;
    max-width: 55ch;
  }
  .hero-points li {
    position: relative;
    padding-left: 1.3rem;
    font-size: 0.95rem;
    line-height: 1.6;
    color: var(--color-text-secondary);
  }
  .hero-points li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.7rem;
    width: 7px;
    height: 7px;
    background: var(--color-accent);
    border-radius: 50%;
  }
  .hero-actions {
    display: flex;
    gap: 0.9rem;
    flex-wrap: wrap;
  }

  .hero-support {
    padding: 1.5rem 1.5rem 1.6rem;
    background:
      linear-gradient(180deg, rgba(248, 242, 233, 0.94) 0%, rgba(255, 255, 255, 0.98) 100%);
  }
  .hero-support-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 0.8rem;
  }
  .hero-support h2 {
    font-family: var(--font-serif);
    font-size: 1.75rem;
    font-weight: 500;
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin-bottom: 0.85rem;
  }
  .hero-support-copy {
    font-size: 0.98rem;
    line-height: 1.65;
    color: var(--color-text-secondary);
    margin-bottom: 1.3rem;
  }
  .hero-support-grid {
    display: grid;
    gap: 1rem;
  }
  .support-row {
    padding-top: 1rem;
    border-top: 1px solid var(--color-border-light);
  }
  .support-row span {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
    margin-bottom: 0.45rem;
  }
  .support-row p {
    font-size: 0.92rem;
    line-height: 1.58;
    color: var(--color-text-secondary);
  }

  .section {
    padding: var(--space-xl) 0;
  }
  .section-dark {
    background: var(--color-text);
    color: var(--color-bg);
    position: relative;
  }
  .section-dark::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 12% 20%, rgba(139, 69, 19, 0.12) 0%, transparent 50%),
      radial-gradient(ellipse at 86% 70%, rgba(196, 149, 106, 0.08) 0%, transparent 50%);
    pointer-events: none;
  }
  .section-warm {
    background: var(--color-bg-warm);
    position: relative;
  }
  .section-warm::before {
    content: "";
    position: absolute;
    inset: 0;
    background: radial-gradient(ellipse at 50% 0%, rgba(139, 69, 19, 0.05) 0%, transparent 52%);
    pointer-events: none;
  }
  .section-intro {
    font-size: 1.05rem;
    color: rgba(245, 242, 236, 0.7);
    margin-top: -2rem;
    margin-bottom: 3rem;
    max-width: 560px;
    line-height: 1.7;
    position: relative;
    z-index: 1;
  }
  .section-intro-light,
  .principles-intro {
    font-family: var(--font-serif);
    font-size: 1.12rem;
    font-style: italic;
    color: var(--color-text-muted);
    margin-top: -2rem;
    margin-bottom: 3rem;
    max-width: 580px;
    line-height: 1.65;
  }

  .tracks-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1.5rem;
    position: relative;
    z-index: 1;
  }
  .track-card {
    display: flex;
    flex-direction: column;
    background: rgba(245, 242, 236, 0.06);
    border: 1px solid rgba(245, 242, 236, 0.12);
    border-top: 2px solid rgba(196, 149, 106, 0.3);
    border-radius: 14px;
    padding: 1.7rem;
    color: rgba(245, 242, 236, 0.92);
    transition:
      border-color 0.2s,
      border-top-color 0.3s,
      background 0.2s,
      transform 0.2s,
      box-shadow 0.2s;
  }
  .track-card:hover {
    border-color: rgba(245, 242, 236, 0.22);
    border-top-color: var(--color-highlight);
    background: rgba(245, 242, 236, 0.09);
    transform: translateY(-3px);
    box-shadow: 0 12px 28px rgba(0, 0, 0, 0.2);
  }
  .track-label,
  .track-meta {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .track-label {
    color: var(--color-highlight);
    margin-bottom: 0.55rem;
  }
  .track-meta {
    color: rgba(245, 242, 236, 0.48);
    margin-bottom: 1rem;
  }
  .track-card h3 {
    font-family: var(--font-serif);
    font-size: 1.4rem;
    font-weight: 400;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }
  .track-card p {
    font-size: 0.92rem;
    line-height: 1.65;
    color: rgba(245, 242, 236, 0.7);
    flex: 1;
    margin-bottom: 1rem;
  }
  .track-services {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    color: rgba(245, 242, 236, 0.4);
    margin-bottom: 1.2rem;
    line-height: 1.7;
  }
  .track-link {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    color: var(--color-highlight);
    letter-spacing: 0.06em;
  }

  .process-timeline {
    display: flex;
    flex-direction: column;
    gap: 0;
  }
  .process-step {
    display: grid;
    grid-template-columns: 60px 1fr;
    gap: 2rem;
    min-height: 140px;
  }
  .step-marker {
    display: flex;
    flex-direction: column;
    align-items: center;
  }
  .step-number {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    font-weight: 600;
    width: 40px;
    height: 40px;
    display: flex;
    align-items: center;
    justify-content: center;
    border: 1.5px solid var(--color-accent);
    border-radius: 50%;
    color: var(--color-accent);
    flex-shrink: 0;
    background: var(--color-bg);
    box-shadow: 0 0 0 4px var(--color-bg), 0 2px 8px rgba(139, 69, 19, 0.08);
  }
  .step-line {
    width: 1px;
    flex: 1;
    background: var(--color-border);
    margin: 0.75rem 0;
  }
  .step-content {
    padding-bottom: 2.5rem;
  }
  .step-content h3 {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    font-weight: 500;
    margin-bottom: 0.75rem;
    transition: color 0.2s;
  }
  .process-step:hover .step-content h3 {
    color: var(--color-accent);
  }
  .step-content > p {
    font-size: 0.95rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
    max-width: 600px;
  }

  .principles-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
    gap: 1.5rem;
  }
  .principles-more {
    margin-top: 3rem;
    text-align: center;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-copy,
    .hero-support {
      animation: fadeUp 0.6s ease-out both;
    }
    .hero-support {
      animation-delay: 0.15s;
    }
  }
  @keyframes fadeUp {
    from {
      opacity: 0;
      transform: translateY(16px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 900px) {
    .hero {
      grid-template-columns: 1fr;
      padding: 7.5rem 2rem 2.5rem;
      gap: 1.5rem;
    }
    .hero h1 {
      max-width: none;
    }
    .tracks-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 768px) {
    .hero {
      padding: 7rem 1.5rem 2.25rem;
    }
    .container {
      padding: 0 1.5rem;
    }
    .hero-points {
      gap: 0.7rem;
    }
    .hero-actions {
      flex-direction: column;
      align-items: stretch;
    }
    .hero-actions .btn {
      width: 100%;
    }
    .process-step {
      grid-template-columns: 44px 1fr;
      gap: 1.25rem;
    }
    .principles-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
