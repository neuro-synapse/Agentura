---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import PrincipleCard from "../components/PrincipleCard.astro";
import { principles, sectionLabels } from "../data/principles";
import { routeCtas } from "../data/site";

const sections = ["intent", "method", "culture"] as const;
const taoCta = routeCtas.tao;
---

<Layout
  title="The Tao of Agentura — Fifteen Principles"
  description="The working principles behind Agentura's approach to agentic systems."
>
  <Nav />

  <main>
    <section class="manifesto-hero">
      <div class="container manifesto-grid">
        <div class="manifesto-copy" data-reveal>
          <div class="manifesto-kicker">Manifesto</div>
          <h1>The Tao of Agentura</h1>
          <p class="manifesto-intro">
            Fifteen principles about intent, method, and culture. This is the document
            underneath the services page: how we decide what to automate, how we keep
            agents aligned with reality, and what kind of work we refuse to romanticize.
          </p>

          <div class="manifesto-actions">
            <a class="btn btn-secondary" href="#principles-start">Read the principles</a>
            <a class="btn btn-ghost" href="/blog">Read the essays</a>
          </div>
        </div>

        <aside class="manifesto-aside surface-card" data-reveal>
          <div class="manifesto-aside-kicker">{taoCta.kicker}</div>
          <h2>{taoCta.heading}</h2>
          <p>{taoCta.body}</p>

          <div class="manifesto-aside-actions">
            <a class="btn btn-primary" href={taoCta.primary.href}>
              {taoCta.primary.label}
            </a>
            {taoCta.secondary && (
              <a class="btn btn-secondary" href={taoCta.secondary.href}>
                {taoCta.secondary.label}
              </a>
            )}
          </div>
        </aside>
      </div>
    </section>

    <section class="reading-note">
      <div class="container reading-note-inner" data-reveal>
        <div class="section-label">How to use this page</div>
        <p>
          The principles are grouped in the order they matter in practice: clarify
          intent, build the harness, then shape the culture around visible reasoning
          and compound learning.
        </p>
      </div>
    </section>

    <div class="principles" id="principles-start">
      {sections.map((section) => (
        <section class="principle-section">
          <div class="section-head" data-reveal>
            <span class="section-rule"></span>
            <span class="section-name">{sectionLabels[section]}</span>
            <span class="section-rule"></span>
          </div>

          {principles
            .filter((principle) => principle.section === section)
            .map((principle) => (
              <div data-reveal>
                <PrincipleCard
                  number={principle.number}
                  title={principle.title}
                  body={principle.body}
                  variant="full"
                />
              </div>
            ))}
        </section>
      ))}
    </div>

    <section class="colophon" data-reveal>
      <div class="colophon-rule"></div>
      <p class="colophon-text">
        These principles are living convictions, not fixed rules.<br />
        They evolve as our understanding deepens —<br />
        which, if we are doing our work well,<br />
        it always will.
      </p>
      <div class="colophon-sig">Agentura &middot; March 2026</div>
    </section>
  </main>

  <Footer />
</Layout>

<style>
  .container {
    max-width: 76rem;
    margin: 0 auto;
    padding: 0 2rem;
  }

  .manifesto-hero {
    padding: 8.5rem 0 3.5rem;
  }

  .manifesto-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(19rem, 0.9fr);
    gap: 2rem;
    align-items: start;
  }

  .manifesto-kicker,
  .manifesto-aside-kicker,
  .section-label,
  .section-name {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .manifesto-kicker,
  .section-label,
  .section-name {
    color: var(--color-accent);
  }

  .manifesto-copy h1 {
    font-family: var(--font-serif);
    font-size: clamp(3rem, 5vw, 4.8rem);
    font-weight: 300;
    line-height: 1.04;
    letter-spacing: -0.04em;
    margin: 0.9rem 0 1.3rem;
  }

  .manifesto-intro {
    max-width: 42rem;
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
  }

  .manifesto-actions,
  .manifesto-aside-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.9rem;
    margin-top: 2rem;
  }

  .manifesto-aside {
    padding: 1.5rem;
    border-color: rgba(139, 69, 19, 0.16);
  }

  .manifesto-aside-kicker {
    color: var(--color-text-faint);
    margin-bottom: 0.7rem;
  }

  .manifesto-aside h2 {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    line-height: 1.2;
    margin-bottom: 0.75rem;
  }

  .manifesto-aside p,
  .reading-note-inner p {
    font-family: var(--font-serif);
    font-size: 1rem;
    line-height: 1.7;
    color: var(--color-text-secondary);
  }

  .reading-note {
    padding: 0 0 2rem;
  }

  .reading-note-inner {
    max-width: 50rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--color-border);
  }

  .section-label {
    margin-bottom: 0.65rem;
  }

  .principles {
    max-width: var(--max-width-narrow);
    margin: 0 auto;
    padding: 0 2rem 2rem;
  }

  .principle-section + .principle-section {
    margin-top: 3rem;
  }

  .section-head {
    display: flex;
    align-items: center;
    gap: 1rem;
    justify-content: center;
    padding: 2rem 0;
  }

  .section-rule {
    flex: 1;
    max-width: 6rem;
    height: 1px;
    background: var(--color-border);
  }

  .colophon {
    max-width: var(--max-width-narrow);
    margin: 0 auto;
    padding: 5rem 2rem 8rem;
    text-align: center;
  }

  .colophon-rule {
    width: 3rem;
    height: 1px;
    background: var(--color-border);
    margin: 0 auto 2rem;
  }

  .colophon-text {
    font-family: var(--font-serif);
    font-weight: 300;
    font-style: italic;
    font-size: 1.1rem;
    line-height: 1.8;
    color: var(--color-text-secondary);
    margin-bottom: 1rem;
  }

  .colophon-sig {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-faint);
  }

  @media (max-width: 900px) {
    .manifesto-grid {
      grid-template-columns: 1fr;
    }
  }

  @media (max-width: 720px) {
    .container,
    .principles,
    .colophon {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
    }

    .manifesto-hero {
      padding: 7rem 0 2.5rem;
    }

    .manifesto-actions,
    .manifesto-aside-actions {
      flex-direction: column;
      align-items: stretch;
    }
  }
</style>
