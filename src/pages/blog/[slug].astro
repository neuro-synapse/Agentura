---
import Layout from "../../layouts/Layout.astro";
import Nav from "../../components/Nav.astro";
import Footer from "../../components/Footer.astro";
import CTA from "../../components/CTA.astro";
import { getCollection, render } from "astro:content";
import { routeCtas } from "../../data/site";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const articleCta = routeCtas.article;

const formattedDate = post.data.pubDate.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<Layout title={`${post.data.title} — Agentura`} description={post.data.description}>
  <Nav />

  <main>
    <article class="article">
      <div class="container">
        <header class="article-header">
          <a href="/blog" class="back-link">&larr; Back to blog</a>
          <div class="article-meta">
            <time datetime={post.data.pubDate.toISOString()}>{formattedDate}</time>
            {post.data.tags.length > 0 && (
              <div class="article-tags">
                {post.data.tags.map((tag) => (
                  <span class="tag">{tag}</span>
                ))}
              </div>
            )}
          </div>
          <h1>{post.data.title}</h1>
          <p class="article-desc">{post.data.description}</p>
        </header>

        <div class="article-body">
          <Content />
        </div>
      </div>
    </article>

    <CTA
      kicker={articleCta.kicker}
      heading={articleCta.heading}
      body={articleCta.body}
      primary={articleCta.primary}
      secondary={articleCta.secondary}
    />
  </main>

  <Footer />
</Layout>

<style>
  .container {
    max-width: var(--max-width-narrow);
    margin: 0 auto;
    padding: 0 2rem;
  }

  .article {
    padding: 8rem 0 4rem;
  }

  .back-link {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: none;
    display: inline-block;
    margin-bottom: 2.5rem;
  }

  .back-link:hover {
    color: var(--color-accent);
    border-bottom: none;
  }

  .article-meta {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
    flex-wrap: wrap;
  }

  .article-meta time {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--color-text-muted);
  }

  .article-tags {
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }

  .tag {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    background: rgba(139, 69, 19, 0.08);
    border: 1px solid rgba(139, 69, 19, 0.12);
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
  }

  .article-header h1 {
    font-family: var(--font-serif);
    font-size: clamp(2.4rem, 5vw, 3.4rem);
    font-weight: 500;
    line-height: 1.1;
    letter-spacing: -0.03em;
    margin-bottom: 1.25rem;
    color: var(--color-text);
  }

  .article-desc {
    font-family: var(--font-serif);
    font-size: 1.1rem;
    line-height: 1.75;
    font-style: italic;
    color: var(--color-text-secondary);
    margin-bottom: 3rem;
    padding-bottom: 2.5rem;
    background-image: linear-gradient(
      90deg,
      transparent,
      var(--color-border),
      var(--color-accent-light),
      var(--color-border),
      transparent
    );
    background-size: 100% 1px;
    background-position: bottom;
    background-repeat: no-repeat;
  }

  .article-body {
    font-family: var(--font-serif);
    font-size: 1.15rem;
    line-height: 1.75;
    color: var(--color-text);
    font-weight: 300;
  }

  .article-body :global(p:first-of-type::first-letter) {
    float: left;
    font-size: 5.5rem;
    line-height: 0.82;
    padding-right: 0.5rem;
    padding-top: 0.08em;
    font-family: var(--font-serif);
    font-weight: 400;
    color: var(--color-accent);
  }

  .article-body :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.6rem;
    font-weight: 500;
    margin-top: 3rem;
    margin-bottom: 1rem;
    letter-spacing: -0.01em;
  }

  .article-body :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 500;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
  }

  .article-body :global(p) {
    margin-bottom: 1.6rem;
    color: var(--color-text-secondary);
  }

  .article-body :global(strong) {
    color: var(--color-text);
    font-weight: 500;
  }

  .article-body :global(em) {
    font-style: italic;
  }

  .article-body :global(ul),
  .article-body :global(ol) {
    margin-bottom: 1.5rem;
    padding-left: 1.5rem;
  }

  .article-body :global(li) {
    margin-bottom: 0.5rem;
    color: var(--color-text-secondary);
  }

  .article-body :global(blockquote) {
    border-left: 3px solid var(--color-accent);
    margin: 2.5rem -1rem;
    padding: 1.5rem 1.5rem 1.5rem 2rem;
    font-style: italic;
    background: var(--color-accent-faint);
  }

  .article-body :global(blockquote p) {
    font-family: var(--font-serif);
    font-size: 1.35rem;
    line-height: 1.45;
    color: var(--color-text);
    font-weight: 400;
  }

  .article-body :global(blockquote p:last-child) {
    margin-bottom: 0;
  }

  .article-body :global(img) {
    width: calc(100% + 4rem);
    max-width: calc(100% + 4rem);
    margin-left: -2rem;
    margin-right: -2rem;
    margin-top: 2.5rem;
    margin-bottom: 0.75rem;
    background: var(--color-bg-warm);
    padding: 0.4rem;
  }

  .article-body :global(img + em),
  .article-body :global(p > img + br + em) {
    display: block;
    font-family: var(--font-mono);
    font-size: 0.65rem;
    font-style: normal;
    text-transform: uppercase;
    letter-spacing: 0.15em;
    color: var(--color-text-muted);
    margin-bottom: 2.5rem;
    text-align: center;
  }

  .article-body :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background: var(--color-bg-warm);
    padding: 0.15rem 0.4rem;
    border-radius: 3px;
  }

  .article-body :global(pre) {
    background: var(--color-text);
    color: var(--color-bg);
    padding: 1.5rem;
    border-radius: 6px;
    overflow-x: auto;
    margin: 2rem 0;
    font-size: 0.85rem;
    line-height: 1.6;
  }

  .article-body :global(pre code) {
    background: none;
    padding: 0;
    color: inherit;
  }

  .article-body :global(a) {
    color: var(--color-accent);
    border-bottom: 1px solid var(--color-accent-light);
  }

  .article-body :global(a:hover) {
    border-bottom-color: var(--color-accent);
  }

  .article-body :global(hr) {
    border: none;
    margin: 3.5rem 0;
    text-align: center;
    position: relative;
    height: 1px;
    background: linear-gradient(
      90deg,
      transparent,
      var(--color-border),
      var(--color-accent-light),
      var(--color-border),
      transparent
    );
  }

  .article-body :global(hr)::after {
    content: "§";
    font-family: var(--font-serif);
    font-size: 1rem;
    color: var(--color-accent);
    background: var(--color-bg);
    padding: 0 0.75rem;
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
  }

  @media (max-width: 768px) {
    .article {
      padding: 7rem 0 3rem;
    }

    .container {
      padding: 0 1.25rem;
    }
  }
</style>
