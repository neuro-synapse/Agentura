---
import Layout from "../layouts/Layout.astro";
import Nav from "../components/Nav.astro";
import Footer from "../components/Footer.astro";
import TrackHeader from "../components/TrackHeader.astro";
import ServiceCard from "../components/ServiceCard.astro";
import CTA from "../components/CTA.astro";
import { services, tracks, getServicesByTrack } from "../data/services";

const entryService = getServicesByTrack('entry')[0];
const trackIServices = getServicesByTrack('I');
const trackIIServices = getServicesByTrack('II');
const trackIIIServices = getServicesByTrack('III');
---

<Layout title="Services — Agentura">

  <Nav />

  <main>

    <!-- ═══ COVER ═══ -->
    <section class="cover">
      <div class="cover-orn"></div>
      <div class="cover-kick">Service Architecture</div>
      <h1 class="cover-title">How We <em>Work</em></h1>
      <p class="cover-sub">
        We design, build, and operationalize agentic systems<br />
        that compound in value over time.<br />
        Here is what that looks like in practice.
      </p>

      <nav class="cover-nav">
        <a href="#assess"><span class="num">00</span> Agentic Readiness Assessment</a>
        <div class="nav-divider"></div>
        <a href="#t1"><span class="num">I</span> For organizations building agentic systems</a>
        {trackIServices.map((s) => (
          <a href={`#s${s.number}`}><span class="num">{s.number}</span> {s.name}</a>
        ))}
        <div class="nav-divider"></div>
        <a href="#t2"><span class="num">II</span> For SaaS products going agent-ready</a>
        {trackIIServices.map((s) => (
          <a href={`#s${s.number}`}><span class="num">{s.number}</span> {s.name}</a>
        ))}
        <div class="nav-divider"></div>
        <a href="#t3"><span class="num">III</span> For small businesses</a>
        {trackIIIServices.map((s) => (
          <a href={`#s${s.number}`}><span class="num">{s.number}</span> {s.name}</a>
        ))}
      </nav>
    </section>

    <!-- ═══ ENTRY POINT ═══ -->
    <section class="entry-section" id="assess">
      <div class="container">
        <ServiceCard service={entryService} />
      </div>
    </section>

    <!-- ═══ TRACK I ═══ -->
    <div class="container" id="t1">
      <TrackHeader
        label={tracks.I.label}
        title={tracks.I.title}
        description={tracks.I.description}
      />
      {trackIServices.map((s) => (
        <ServiceCard service={s} />
      ))}
    </div>

    <!-- ═══ TRACK II ═══ -->
    <div class="container" id="t2">
      <TrackHeader
        label={tracks.II.label}
        title={tracks.II.title}
        description={tracks.II.description}
      />
      {trackIIServices.map((s) => (
        <ServiceCard service={s} />
      ))}
    </div>

    <!-- ═══ TRACK III ═══ -->
    <section class="lab-section" id="t3">
      <div class="container">
        <TrackHeader
          label={tracks.III.label}
          title={tracks.III.title}
          description={tracks.III.description}
        />
        {trackIIIServices.map((s) => (
          <ServiceCard service={s} />
        ))}
      </div>
    </section>

    <!-- ═══ CTA ═══ -->
    <CTA
      heading="Not sure where to start?"
      body="The Agentic Readiness Assessment exists precisely for that. One week, clear findings, honest recommendations."
    />

  </main>

  <Footer />

</Layout>

<style>
  .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ═══ COVER ═══ */
  .cover {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: 4rem 2rem;
    position: relative;
  }
  .cover::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse at 25% 45%, rgba(139,69,19,0.03) 0%, transparent 60%),
      radial-gradient(ellipse at 75% 55%, rgba(139,69,19,0.02) 0%, transparent 60%);
    pointer-events: none;
  }
  .cover-orn {
    width: 60px;
    height: 1px;
    background: var(--color-accent);
    margin: 0 auto 2.5rem;
    position: relative;
    opacity: 0;
    animation: fadeIn 1s 0.3s forwards;
  }
  .cover-orn::before,
  .cover-orn::after {
    content: '';
    position: absolute;
    width: 6px;
    height: 6px;
    border: 1px solid var(--color-accent);
    border-radius: 50%;
    top: -3px;
  }
  .cover-orn::before { left: -10px; }
  .cover-orn::after { right: -10px; }
  .cover-kick {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    font-weight: 500;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-accent);
    margin-bottom: 1.5rem;
    opacity: 0;
    animation: fadeIn 1s 0.5s forwards;
  }
  .cover-title {
    font-family: var(--font-serif);
    font-weight: 300;
    font-size: clamp(2.5rem, 5.5vw, 4.5rem);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin-bottom: 0.4em;
    opacity: 0;
    animation: fadeIn 1.2s 0.3s forwards;
  }
  .cover-title em {
    font-style: italic;
    font-weight: 400;
    color: var(--color-accent);
  }
  .cover-sub {
    font-family: var(--font-serif);
    font-weight: 300;
    font-style: italic;
    font-size: clamp(0.95rem, 1.8vw, 1.15rem);
    color: var(--color-text-muted);
    max-width: 520px;
    margin: 0 auto;
    line-height: 1.7;
    opacity: 0;
    animation: fadeIn 1.2s 0.45s forwards;
  }

  /* ═══ ANCHOR NAV ═══ */
  .cover-nav {
    margin-top: 3.5rem;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    align-items: center;
    opacity: 0;
    animation: fadeIn 1s 0.6s forwards;
  }
  .cover-nav a {
    font-family: var(--font-mono);
    font-size: 0.58rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-text-muted);
    border-bottom: none;
    transition: color 0.3s, padding-left 0.3s;
    padding: 0.2rem 0;
  }
  .cover-nav a:hover {
    color: var(--color-accent);
    border-bottom: none;
    padding-left: 0.5rem;
  }
  .cover-nav .num {
    color: var(--color-accent-light);
    margin-right: 0.5em;
    font-weight: 500;
    display: inline-block;
    min-width: 1.8em;
  }
  .nav-divider {
    width: 30px;
    height: 1px;
    background: var(--color-border);
    margin: 0.6rem 0;
  }

  /* ═══ ENTRY SECTION ═══ */
  .entry-section {
    background: var(--color-bg-warm);
    padding: 5rem 0;
  }
  .entry-section .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  /* ═══ LAB SECTION ═══ */
  .lab-section {
    background: var(--color-bg-cool);
    padding: 5rem 0;
  }
  .lab-section .container {
    max-width: 760px;
    margin: 0 auto;
    padding: 0 2rem;
  }

  @keyframes fadeIn {
    from { opacity: 0; transform: translateY(8px); }
    to { opacity: 1; transform: translateY(0); }
  }

  @media (max-width: 768px) {
    .container { padding: 0 1.25rem; }
    .cover-nav {
      align-items: flex-start;
      padding: 0 1.5rem;
    }
  }
</style>
